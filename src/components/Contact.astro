---
const contacts = [
  {
    label: 'Email',
    value: 'joan.leyton06@gmail.com',
    href: 'mailto:joan.leyton06@gmail.com',
    desc: 'Best way to reach me',
    icon: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>',
  },
  {
    label: 'LinkedIn',
    value: '/joan-leyton-carrillo',
    href: 'https://www.linkedin.com/in/joan-leyton-carrillo-b05369228/',
    desc: 'Professional network',
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  },
  {
    label: 'GitHub',
    value: 'github.com/joanscure',
    href: 'https://github.com/joanscure',
    desc: 'My open source work',
    icon: '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
  },
  {
    label: 'WhatsApp',
    value: '+51 943 549 521',
    href: 'https://wa.me/51943549521',
    desc: 'Direct message',
    icon: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.63 3.38 2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.78a16 16 0 0 0 6.29 6.29l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>',
  },
];
---

<section id="contact" class="py-24 md:py-36">
  <div class="section">
    <div class="max-w-3xl mx-auto">

      <div class="text-center mb-14 reveal">
        <div class="inline-flex items-center gap-2 text-xs font-mono text-[var(--color-primary-light)] uppercase tracking-widest mb-4">
          <span class="w-6 h-px bg-[var(--color-primary)]"></span>
          Contact
          <span class="w-6 h-px bg-[var(--color-primary)]"></span>
        </div>
        <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-text)] mb-4 leading-tight">
          Let's build something<br />
          <span class="gradient-text">great together</span>
        </h2>
        <p class="text-[var(--color-text-muted)] max-w-lg mx-auto leading-relaxed text-sm md:text-base text-center">
          Open to full-time roles, freelance contracts, and technical consulting.
          If you have a challenging problem and a high bar for quality — let's talk.
        </p>
      </div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12 reveal">
        {contacts.map(({ label, value, href, icon, desc }) => (
          <a
            href={href}
            target={href.startsWith('http') ? '_blank' : undefined}
            rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="card p-4 md:p-5 flex flex-col items-center text-center gap-3 group"
          >
            <div class="w-10 h-10 rounded-xl bg-[var(--color-primary)]/10 border border-[var(--color-primary)]/30 flex items-center justify-center text-[var(--color-primary-light)] group-hover:bg-[var(--color-primary)]/20 transition-colors duration-200">
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon}></svg>
            </div>
            <div class="min-w-0 w-full">
              <p class="text-[10px] font-mono text-[var(--color-text-subtle)] mb-0.5">{desc}</p>
              <p class="text-xs font-semibold text-[var(--color-primary-light)] truncate">{label}</p>
            </div>
          </a>
        ))}
      </div>

      <!-- Main CTA -->
      <div class="reveal text-center">
        <div class="inline-block p-px rounded-2xl bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)] w-full max-w-lg">
          <div class="bg-[var(--color-surface)] rounded-2xl px-8 py-10 flex flex-col items-center gap-5">
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed text-center">
              I respond within 24 hours. No recruiters pitching, please — direct opportunities only.
            </p>
            <a
              href="mailto:joan.leyton06@gmail.com"
              class="inline-flex items-center gap-3 px-8 py-3.5 rounded-lg bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)] text-white font-semibold text-sm hover:opacity-90 transition-opacity duration-200 hover:shadow-[0_0_32px_var(--color-primary-glow)]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              joan.leyton06@gmail.com
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
