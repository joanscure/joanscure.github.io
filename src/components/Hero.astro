---
---

<section id="hero">
  <div class="hero-bg">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <div class="grid-overlay"></div>
  </div>

  <div class="hero-inner">
    <div class="badge-available">
      <span class="dot"></span>
      Available for new opportunities
    </div>

    <h1 class="hero-name">
      <span>Joan</span>
      <span class="gradient-text">Leyton</span>
    </h1>

    <div class="hero-role">
      <span id="typewriter"></span><span class="typewriter-cursor">|</span>
    </div>

    <p class="hero-tagline">
      I build things that scale — from microservices handling 200k+ records to mobile
      apps shipped to thousands of users. Seven years of turning complex problems into
      clean, maintainable software.
    </p>

    <div class="hero-cta">
      <a href="#projects" class="btn btn-primary">View My Work</a>
      <a href="#contact"  class="btn btn-outline">Get In Touch</a>
    </div>

    <div class="stats-grid">
      {[
        { count: '7',  suffix: '+', label: 'Years of experience' },
        { count: '5',  suffix: '',  label: 'Industries served' },
        { count: '15', suffix: '+', label: 'Projects shipped' },
        { count: '3',  suffix: '',  label: 'Countries worked in' },
      ].map(({ count, suffix, label }) => (
        <div class="stat-item">
          <div class="stat-value gradient-text" data-count={count} data-suffix={suffix}>{count}{suffix}</div>
          <div class="stat-label">{label}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="scroll-hint">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  #hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 56rem;
    margin: 0 auto;
    padding: 7rem 1.5rem 5rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .hero-inner { padding: 8rem 2.5rem 5rem; }
  }

  .hero-name {
    display: flex;
    flex-direction: column;
    font-size: clamp(3.5rem, 10vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }
  .hero-name .gradient-text { padding-bottom: 0.15em; }

  .hero-role {
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
  }

  .hero-tagline {
    max-width: 40rem;
    margin: 0 auto 2.5rem;
    font-size: 1rem;
    color: var(--color-text-subtle);
    line-height: 1.7;
    padding: 0 0.25rem;
  }
  @media (min-width: 640px) {
    .hero-tagline { font-size: 1.0625rem; }
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    animation: float 8s ease-in-out infinite;
  }
  .orb-1 {
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(124,58,237,.18) 0%, transparent 70%);
    top: -100px; left: -100px;
  }
  .orb-2 {
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(6,182,212,.13) 0%, transparent 70%);
    bottom: 0; right: -80px;
    animation-delay: -3s;
  }
  .orb-3 {
    width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(124,58,237,.09) 0%, transparent 70%);
    top: 50%; left: 50%;
    animation-delay: -5s;
    animation-name: float-center;
  }
  @keyframes float {
    0%,100% { transform: translate(0,0) scale(1); }
    33%      { transform: translate(20px,-20px) scale(1.05); }
    66%      { transform: translate(-15px,15px) scale(.95); }
  }
  @keyframes float-center {
    0%,100% { transform: translate(-50%,-50%) scale(1); }
    33%      { transform: translate(-48%,-52%) scale(1.05); }
    66%      { transform: translate(-52%,-48%) scale(.95); }
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 0%, transparent 70%);
  }

  .typewriter-cursor {
    color: var(--color-primary-light);
    animation: blink 1s step-end infinite;
  }
  @keyframes blink {
    0%,100% { opacity: 1; } 50% { opacity: 0; }
  }

  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-subtle);
  }
  .scroll-line {
    width: 1px;
    height: 2rem;
    background: linear-gradient(to bottom, var(--color-text-subtle), transparent);
    animation: bounce-line 2s ease-in-out infinite;
  }
  @keyframes bounce-line {
    0%,100% { transform: scaleY(1); opacity: 1; }
    50%      { transform: scaleY(0.6); opacity: 0.4; }
  }
</style>

<script>
  const roles = [
    'Full Stack Engineer',
    'Software Architect',
    'Technical Leader',
    'API Designer',
    'AI Systems Builder',
  ];
  let roleIndex = 0, charIndex = 0, isDeleting = false;
  const el = document.getElementById('typewriter')!;

  function type() {
    const current = roles[roleIndex];
    el.textContent = isDeleting
      ? current.slice(0, charIndex - 1)
      : current.slice(0, charIndex + 1);
    isDeleting ? charIndex-- : charIndex++;

    if (!isDeleting && charIndex === current.length) {
      isDeleting = true;
      setTimeout(type, 1800);
      return;
    }
    if (isDeleting && charIndex === 0) {
      isDeleting = false;
      roleIndex = (roleIndex + 1) % roles.length;
    }
    setTimeout(type, isDeleting ? 55 : 95);
  }
  type();
</script>
